package azs017

import (
	fwschema "github.com/hashicorp/terraform-plugin-framework/resource/schema"
	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/schema"
)

func flagged() *schema.Resource {
	return &schema.Resource{
		Schema: map[string]*schema.Schema{
			"name": {
				Type:        schema.TypeString,
				Description: "The name of the Webhook.", // want `description opens with "Specifies the" - open with "The"`
			},

			"scopes": {
				Type:        schema.TypeString,
				Description: "A list of scopes to be requested as part of Facebook Login authentication.", // want `description opens with "Specifies a" - open with "A"`
			},

			"http2_enabled": {
				Type:        schema.TypeString,
				Description: "Whether the HTTP2 protocol should be enabled.", // want `description opens with "Specifies if" - open with "Whether"`
			},

			"tracing_enabled": {
				Type:        schema.TypeString,
				Description: `Whether tracing is enabled.`, // want `description opens with "Indicates whether" - open with "Whether"`
			},

			"hybrid_worker_id": {
				Type:        schema.TypeString,
				Description: "The ID of this Hybrid Worker in UUID notation.", // want `description opens with "Specify the" - open with "The"`
			},

			// what follows the verb cannot open the description as it stands, so there is no fix
			"interval": {
				Type:        schema.TypeString,
				Description: "Specifies interval in minutes to reevaluate the percentage.", // want `description opens with "Specifies" - say what the property is instead`
			},
		},
	}
}

func flaggedPhrases() *schema.Resource {
	return &schema.Resource{
		Schema: map[string]*schema.Schema{
			"caching_enabled": {
				Type:        schema.TypeString,
				Description: "Whether to enable caching.", // want `description has "or not" - it adds nothing`
			},

			"ldap_over_tls_enabled": {
				Type:        schema.TypeString,
				Description: "Whether the LDAP traffic needs to be secured via TLS.", // want `description opens with "Specifies whether" - open with "Whether"` `description has "or not" - it adds nothing`
			},

			"key": {
				Type:        schema.TypeString,
				Description: "The key used to sign in. It is only shown once.", // want `description has "in order to" - "to" says the same` `description has "Please note" - it adds nothing`
			},

			// "to to" would be left behind, so there is no fix
			"terms_of_service": {
				Type:        schema.TypeString,
				Description: "The Terms of Service which users are required to agree to in order to sign up.", // want `description has "in order to" - "to" says the same`
			},
		},
	}
}

func flaggedFramework() fwschema.Attribute {
	return fwschema.StringAttribute{
		MarkdownDescription: "How the storage adapters between nodes are connected.", // want `description opens with "Defines how" - open with "How"`
	}
}

func passing() *schema.Resource {
	return &schema.Resource{
		Description: "Manages a Webhook.",

		Schema: map[string]*schema.Schema{
			"name": {
				Type:        schema.TypeString,
				Description: "The name of the Webhook. Specifies the Webhook within the Automation Account.",
			},

			"minimum_tls_version": {
				Type:        schema.TypeString,
				Description: "Configures the minimum version of TLS required for requests to the site.",
			},

			"enabled": {
				Type:        schema.TypeString,
				Description: "Whether the Webhook is enabled.",
			},

			"fallback": {
				Type:        schema.TypeString,
				Description: "The value to use when the name is empty or not set.",
			},
		},
	}
}

// a block is described like any other property
func flaggedBlocks() (*schema.Schema, fwschema.Block) {
	return &schema.Schema{
		Type:        schema.TypeList,
		Description: "An identity block.", // want `description opens with "Specifies an" - open with "An"`
	}, fwschema.ListNestedBlock{
		MarkdownDescription: "Which rules apply.", // want `description opens with "Specifies which" - open with "Which"`
	}
}
