package azs014

import (
	"github.com/hashicorp/terraform-plugin-framework-validators/listvalidator"
	"github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
	fwschema "github.com/hashicorp/terraform-plugin-framework/resource/schema"
	"github.com/hashicorp/terraform-plugin-framework/resource/schema/stringplanmodifier"
	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/schema"
	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/validation"

	"azs014/helpers"
)

const shared = "The shared one. Defaults to `a`."

func flagged() *schema.Resource {
	return &schema.Resource{
		Description: "(Resource) Manages a Thing, and more.", // want `description has the tag "\(Optional\)" - the schema already says so`

		Schema: map[string]*schema.Schema{
			"name": {
				Type:        schema.TypeString,
				Required:    true,
				ForceNew:    true,
				Description: "The name of the Thing.", // want `description has the tag "\(Required\)" - the schema already says so` `description says a change forces a new resource - the schema's ForceNew already does`
			},

			"mode": {
				Type:         schema.TypeString,
				Optional:     true,
				Default:      "Fast",
				ValidateFunc: validation.StringInSlice([]string{"Fast", "Slow"}, false),
				Description:  "The mode of the Thing.", // want `description lists the values it can take - the schema's validation already does` `description gives the default - the schema's Default already does`
			},

			"enabled": {
				Type:        schema.TypeBool,
				Optional:    true,
				Default:     true,
				Description: "Should the Thing be enabled?", // want `description has the tag "\(Boolean\)" - the schema already says so` `description lists the values it can take - a bool is always true or false` `description gives the default - the schema's Default already does`
			},

			"size": {
				Type:         schema.TypeInt,
				Optional:     true,
				ValidateFunc: validation.IntBetween(1, 10),
				Description:  "The size of the Thing.", // want `description lists the values it can take - the schema's validation already does`
			},

			"secret": {
				Type:        schema.TypeString,
				Optional:    true,
				Sensitive:   true,
				Description: "The secret of the Thing.", // want `description has the tag "\(Optional, Sensitive\)" - the schema already says so`
			},

			"zones": {
				Type:     schema.TypeList,
				Optional: true,
				Elem: &schema.Schema{
					Type:         schema.TypeString,
					ValidateFunc: validation.StringInSlice([]string{"1", "2", "3"}, false),
				},
				Description: "The zones to use.", // want `description lists the values it can take - the schema's validation already does`
			},

			"sku": {
				Type:          schema.TypeList,
				Optional:      true,
				ConflictsWith: []string{"tier"},
				Elem: &schema.Resource{
					Schema: map[string]*schema.Schema{
						"tier": {
							Type:        schema.TypeString,
							Optional:    true,
							Default:     "Basic",
							Description: "The tier of the SKU.", // want `description gives the default - the schema's Default already does`
						},
					},
				},
				Description: "A `sku` block.", // want `description points at the docs page with "as defined below" - a description has no page around it` `description says what it conflicts with - the schema's ConflictsWith or ExactlyOneOf already does`
			},

			"only": {
				Type:         schema.TypeString,
				Optional:     true,
				ValidateFunc: validation.StringInSlice([]string{"a", "b"}, false),
				Description:  "Possible values are `a` and `b`.", // want `description lists the values it can take - the schema's validation already does`
			},

			"raw": {
				Type:        schema.TypeString,
				Optional:    true,
				Default:     "a",
				Description: `The raw one.`, // want `description gives the default - the schema's Default already does`
			},

			"label": {
				Type:        schema.TypeString,
				Optional:    true,
				ForceNew:    true,
				Description: "The label of the Thing.", // want `description says a change forces a new resource - the schema's ForceNew already does`
			},

			"protocol": {
				Type:         schema.TypeString,
				Optional:     true,
				ValidateFunc: validation.StringInSlice([]string{"Http", "Https"}, false),
				Description:  "The protocol to use.", // want `description lists the values it can take - the schema's validation already does`
			},

			"verb": {
				Type:         schema.TypeString,
				Optional:     true,
				ValidateFunc: validation.StringInSlice([]string{"GET", "POST", "PUT"}, false),
				Description:  "Which HTTP verb to use.", // want `description lists the values it can take - the schema's validation already does`
			},

			"owner": {
				Type:        schema.TypeString,
				Optional:    true,
				Default:     "none",
				Description: "The owner, a user or a group.", // want `description gives the default - the schema's Default already does`
			},

			"site": {
				Type:        schema.TypeString,
				Optional:    true,
				Default:     "Default-First-Site-Name",
				Description: "The site to use for discovery.", // want `description gives the default - the schema's Default already does` `description gives the default - the schema's Default already does`
			},

			"key": {
				Type:         schema.TypeString,
				Optional:     true,
				ExactlyOneOf: []string{"key", "secret"},
				Description:  "The key to sign with.", // want `description says one of several must be set - the schema's ExactlyOneOf or AtLeastOneOf already does`
			},

			"rule": {
				Type:     schema.TypeList,
				Optional: true,
				MaxItems: 100,
				Elem: &schema.Resource{
					Schema: map[string]*schema.Schema{},
				},
				Description: "The rules to apply.", // want `description points at the docs page - a description has no page around it` `description says how many there can be - the schema's MaxItems or MinItems already does`
			},

			"title": {
				Type:         schema.TypeString,
				Optional:     true,
				ValidateFunc: validation.StringLenBetween(1, 80),
				Description:  "The title of the Thing.", // want `description says how long it can be - the schema's validation already does`
			},

			"alias": {
				Type:         schema.TypeString,
				Optional:     true,
				ValidateFunc: validation.StringLenBetween(1, 80),
				Description:  "The alias of the Thing, letters and dashes up to 80 characters in length.", // want `description says how long it can be - the schema's validation already does`
			},

			"repository_url": {
				Type:         schema.TypeString,
				Optional:     true,
				RequiredWith: []string{"repository_branch", "repository_token"},
				Description:  "The repository to deploy from.", // want `description says what else must be set - the schema's RequiredWith already does`
			},

			"client_secret": {
				Type:         schema.TypeString,
				Optional:     true,
				ExactlyOneOf: []string{"client_secret", "client_secret_setting_name"},
				Description:  "The client secret.", // want `description says what it conflicts with - the schema's ConflictsWith or ExactlyOneOf already does`
			},

			"tls": {
				Type:         schema.TypeString,
				Optional:     true,
				ValidateFunc: validation.StringInSlice([]string{"1.2", "1.3"}, false),
				Description:  "The minimum version of TLS for the site.", // want `description lists the values it can take - the schema's validation already does`
			},

			"runbook_type": {
				Type:         schema.TypeString,
				Optional:     true,
				ValidateFunc: validation.StringInSlice([]string{"Graph", "Script"}, false),
				Description:  "The type of the runbook.", // want `description lists the values it can take - the schema's validation already does`
			},

			// with no default in the schema the sentence is called out and left, as the only place it is written down
			"always_on": {
				Type:        schema.TypeBool,
				Optional:    true,
				Description: "Should the Thing always be on? Defaults to `false`.", // want `description gives the default - set Default in the schema or take it out; if it has to stay, say why in an //azignore`
			},

			"transport": {
				Type:        schema.TypeString,
				Optional:    true,
				Computed:    true,
				Description: "The transport to use, which defaults to `auto`.", // want `description gives the default - set Default in the schema or take it out; if it has to stay, say why in an //azignore`
			},

			"retries": {
				Type:        schema.TypeInt,
				Optional:    true,
				Default:     nil,
				Description: "The number of retries (defaults to 3) before giving up.", // want `description gives the default - set Default in the schema or take it out; if it has to stay, say why in an //azignore`
			},

			"shared": {
				Type:        schema.TypeString,
				Optional:    true,
				Default:     "a",
				Description: shared, // want `description gives the default - the schema's Default already does`
			},

			// nothing is set on a read-only property, so these go whether or not the schema says them too
			"state": {
				Type:        schema.TypeString,
				Computed:    true,
				Description: "The state of the Thing.", // want `description lists the values it can take - a read-only property cannot be set` `description gives the default - a read-only property cannot be set`
			},

			"endpoint": {
				Type:        schema.TypeString,
				Computed:    true,
				Description: "The endpoint of the Thing. A `sku` block.", // want `description has the tag "\(Computed\)" - the schema already says so` `description says a change forces a new resource - a read-only property cannot be set` `description points at the docs page with "as defined below" - a description has no page around it`
			},
		},
	}
}

func flaggedFramework() fwschema.Schema {
	return fwschema.Schema{
		MarkdownDescription: "Manages a Thing.",

		Attributes: map[string]fwschema.Attribute{
			"kind": fwschema.StringAttribute{
				Optional:            true,
				MarkdownDescription: "The kind of Thing.", // want `description lists the values it can take - the schema's validation already does` `description says a change forces a new resource - the schema's ForceNew already does`
				Validators:          []any{stringvalidator.OneOf("a", "b")},
				PlanModifiers:       []any{stringplanmodifier.RequiresReplace()},
			},

			"on": fwschema.BoolAttribute{
				Optional:    true,
				Description: "Is the Thing on?", // want `description lists the values it can take - a bool is always true or false`
			},

			"title": fwschema.StringAttribute{
				Optional:    true,
				Description: "The title of the Thing.", // want `description says how long it can be - the schema's validation already does`
				Validators:  []any{stringvalidator.LengthBetween(1, 80)},
			},

			"quiet": fwschema.BoolAttribute{
				Optional:    true,
				Description: "Is the Thing quiet? Defaults to `false`.", // want `description gives the default - set Default in the schema or take it out; if it has to stay, say why in an //azignore`
			},

			"status": fwschema.StringAttribute{
				Computed:            true,
				MarkdownDescription: "The status of the Thing.", // want `description lists the values it can take - a read-only property cannot be set`
			},
		},

		Blocks: map[string]fwschema.Block{
			"filter": fwschema.ListNestedBlock{
				Description: "The filters to apply.", // want `description says how many there can be - the schema's MaxItems or MinItems already does`
				Validators:  []any{listvalidator.SizeAtMost(5)},
			},

			"rule": fwschema.ListNestedBlock{
				Description: "One or more `rule` blocks.", // want `description points at the docs page with "as defined below" - a description has no page around it`
			},
		},
	}
}

type ThingResource struct{}

func (ThingResource) ResourceType() string { return "azurerm_thing" }

func (ThingResource) Description() string {
	return "Manages a Thing." // want `description points at the docs page with "as documented below" - a description has no page around it`
}

func passing() *schema.Resource {
	return &schema.Resource{
		Description: "Manages a Thing.",

		Schema: map[string]*schema.Schema{
			// nothing in the schema gives the default, the values or the rule, so the description is the only place they are written down
			"mode": {
				Type:         schema.TypeString,
				Optional:     true,
				Computed:     true,
				ValidateFunc: validation.StringIsNotEmpty,
				Description:  "The mode of the Thing. Possible values are `Fast` and `Slow`. Changing this forces a new Thing to be created. Conflicts with `speed`.",
			},

			"plain": {
				Type:        schema.TypeString,
				Optional:    true,
				Description: "The plain one. Can be `a` or `b`. Changing this forces a new resource. Exactly one of `plain` or `mode` must be specified.",
			},

			"rule": {
				Type:     schema.TypeList,
				Optional: true,
				Elem: &schema.Resource{
					Schema: map[string]*schema.Schema{},
				},
				Description: "The rules to apply. A maximum of `100` `rule` blocks may be defined.",
			},

			// said in a way that tells the reader more than the schema does
			"owner": {
				Type:         schema.TypeString,
				Optional:     true,
				Default:      "none",
				MaxItems:     1,
				ValidateFunc: validation.StringLenBetween(1, 64),
				Description:  "The owner, a user (optional) or a group, who by default is nobody. Limit it to 64 characters to avoid collisions. Only one owner can be set unless `mode` is `Fast`.",
			},

			"sku": {
				Type:     schema.TypeList,
				Optional: true,
				Elem: &schema.Resource{
					Schema: map[string]*schema.Schema{
						"tier": {
							Type:         schema.TypeString,
							Optional:     true,
							ValidateFunc: validation.StringInSlice([]string{"a", "b"}, false),
							Description:  "The tier of the SKU.",
						},
					},
				},
				Description: "The SKU of the Thing. Possible values are whatever the region offers.",
			},

			"built": {
				Type:        schema.TypeString,
				Optional:    true,
				Default:     "a",
				Description: describe("built"),
			},
		},
	}
}

func passingFramework() fwschema.Schema {
	return fwschema.Schema{
		Attributes: map[string]fwschema.Attribute{
			"kind": fwschema.StringAttribute{
				Optional:            true,
				MarkdownDescription: "The kind of Thing. Possible values are `a` and `b`. Changing this forces a new resource to be created.",
				Validators:          []any{stringvalidator.LengthAtLeast(1)},
				PlanModifiers:       []any{stringplanmodifier.UseStateForUnknown()},
			},
		},
	}
}

func describe(name string) string { return "the " + name + ". Defaults to `a`." }

// what checks a duration, as the provider's own validation package has it
func ISO8601Duration(any, string) ([]string, []error) { return nil, nil }

func ISO8601DurationBetween(shortest, longest string) schema.SchemaValidateFunc { return nil }

func validateName(any, string) ([]string, []error) { return nil, nil }

// a range is the schema's to check: it is reported until a validation does, and taken out once one does
func ranges() *schema.Resource {
	return &schema.Resource{
		Schema: map[string]*schema.Schema{
			"lock_duration": {
				Type:         schema.TypeString,
				Optional:     true,
				ValidateFunc: ISO8601Duration,
				Description:  "The lock duration for the queue. This value must be between 5 and 300 seconds.", // want `description gives a range the schema does not check - check it in the schema with ISO8601DurationBetween`
			},

			"ttl": {
				Type:         schema.TypeString,
				Optional:     true,
				ValidateFunc: ISO8601DurationBetween("PT5S", "PT5M"),
				Description:  "The time a message lives for.", // want `description lists the values it can take - the schema's validation already does`
			},

			"retries": {
				Type:        schema.TypeInt,
				Optional:    true,
				Description: "The number of retries. Must be at least `1`.", // want `description gives a range the schema does not check - check it in the schema with IntBetween`
			},

			"priority": {
				Description: "The priority of the rule collection. The range is `100` - `65000`.", // want `description gives a range the schema does not check - check it in the schema with IntBetween`
				Type:        schema.TypeInt,
				Required:    true,
			},

			"order": {
				Type:         schema.TypeInt,
				Required:     true,
				ValidateFunc: validation.IntBetween(100, 65000),
				Description:  "The order of the rule collection.", // want `description lists the values it can take - the schema's validation already does`
			},

			"label": {
				Type:         schema.TypeString,
				Optional:     true,
				ValidateFunc: validation.StringIsNotEmpty,
				Description:  "The label of the Thing. Must be between 1 and 80 characters.", // want `description gives a range the schema does not check - check it in the schema with StringLenBetween`
			},

			"weight": {
				Type:        schema.TypeString,
				Optional:    true,
				Description: "The weight of the Thing. Possible values are between `1` and `100`.", // want `description gives a range the schema does not check - check it in the schema with a validation`
			},

			// a function of the provider's own may well check the range
			"name": {
				Type:         schema.TypeString,
				Required:     true,
				ValidateFunc: validateName,
				Description:  "The name of the Thing. Must be between 1 and 80 characters.",
			},

			"secret_permissions": {
				Type:     schema.TypeList,
				Optional: true,
				Elem: &schema.Schema{
					Type:         schema.TypeString,
					ValidateFunc: validation.StringInSlice([]string{"Backup", "Delete", "Get"}, false),
				},
				Description: "List of secret permissions.", // want `description lists the values it can take - the schema's validation already does`
			},
		},
	}
}

// a helper of this package, with the schema its description ends up on in reach
func modeSchema(description string) *schema.Schema { // want modeSchema:`schema\(1\)`
	return &schema.Schema{
		Type:         schema.TypeString,
		Optional:     true,
		ValidateFunc: validation.StringInSlice([]string{"Fast", "Slow"}, false),
		Description:  description,
	}
}

// a description handed to a helper is checked where it is written, against the schema the helper sets it on
func throughHelpers() *schema.Resource {
	return &schema.Resource{
		Schema: map[string]*schema.Schema{
			"name": helpers.NameSchema("The name of the Thing."), // want `description says a change forces a new resource - the schema's ForceNew already does`

			"mode": modeSchema("The mode of the Thing."), // want `description lists the values it can take - the schema's validation already does`

			"label": helpers.NameSchema("The label of the Thing."),
		},
	}
}

// what the provider fills in is described as what it holds, not as something to set
func readOnly() *schema.Resource {
	return &schema.Resource{
		Schema: map[string]*schema.Schema{
			"preserve_unmatched_path_enabled": {
				Type:        schema.TypeBool,
				Computed:    true,
				Description: "Whether to preserve the unmatched part of the path.", // want `description reads as something to set with "Whether to" - a read-only property cannot be set, say what it holds`
			},

			"https_only": {
				Type:        schema.TypeBool,
				Computed:    true,
				Description: "Whether the Web App requires HTTPS connections.",
			},

			"uid": {
				Type:         schema.TypeString,
				Optional:     true,
				RequiredWith: []string{"gid"},
				Description:  "The user ID.", // want `description says what else must be set - the schema's RequiredWith already does`
			},
		},
	}
}
